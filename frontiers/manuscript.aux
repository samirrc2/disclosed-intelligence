\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Typology prevalence with Wilson 95\% confidence intervals (gpt-4o classifier; $n = 388$ classified brochures). Labels are multi-label.\relax }}{19}{table.caption.9}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:typology}{{1}{19}{Typology prevalence with Wilson 95\% confidence intervals (gpt-4o classifier; $n = 388$ classified brochures). Labels are multi-label.\relax }{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Brochure-filing population counts (exact stratum population deflated by the stratum brochure-filing rate), classified sample sizes, disclosure rates, and sampling weights. The survey-weighted any-use prevalence is 22.7\% (95\% CI 18.7--26.6) versus the design-based 23.7\%; the unadjusted all-firms universe (16{,}223) gives 22.3\%.\relax }}{19}{table.caption.10}\protected@file@percent }
\newlabel{tab:weighting}{{2}{19}{Brochure-filing population counts (exact stratum population deflated by the stratum brochure-filing rate), classified sample sizes, disclosure rates, and sampling weights. The survey-weighted any-use prevalence is 22.7\% (95\% CI 18.7--26.6) versus the design-based 23.7\%; the unadjusted all-firms universe (16{,}223) gives 22.3\%.\relax }{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Disclosed any-use by adviser type and AUM quartile: prevalence (Wilson 95\% CI) [count/denominator]. Wealth/retail denominators are below 50 because the 12 unclassified firms fall in these strata.\relax }}{19}{table.caption.11}\protected@file@percent }
\newlabel{tab:gradient}{{3}{19}{Disclosed any-use by adviser type and AUM quartile: prevalence (Wilson 95\% CI) [count/denominator]. Wealth/retail denominators are below 50 because the 12 unclassified firms fall in these strata.\relax }{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Independent cross-family validation on the blinded 180-brochure verification sample. Metrics are design-weighted (Horvitz--Thompson) to the full classified population: model-positive brochures are censused (inclusion probability 1) and 57 of 265 model-negatives are sampled (inclusion probability 0.215), so each brochure is weighted by the inverse of its inclusion probability. Reference is an independent blind re-coding by a different model family; the primary classifier is gpt-4o. Precision is invariant to the weighting (it conditions on the censused model-positive stratum); recall, $\kappa $, agreement, and prevalence-and-bias-adjusted agreement (PABAK; \citealp  {byrt1993}) are design-weighted. Same-family reproducibility (gpt-4o vs.\ gpt-4o-mini, 60 brochures) is reported in the text.\relax }}{20}{table.caption.12}\protected@file@percent }
\newlabel{tab:validation}{{4}{20}{Independent cross-family validation on the blinded 180-brochure verification sample. Metrics are design-weighted (Horvitz--Thompson) to the full classified population: model-positive brochures are censused (inclusion probability 1) and 57 of 265 model-negatives are sampled (inclusion probability 0.215), so each brochure is weighted by the inverse of its inclusion probability. Reference is an independent blind re-coding by a different model family; the primary classifier is gpt-4o. Precision is invariant to the weighting (it conditions on the censused model-positive stratum); recall, $\kappa $, agreement, and prevalence-and-bias-adjusted agreement (PABAK; \citealp {byrt1993}) are design-weighted. Same-family reproducibility (gpt-4o vs.\ gpt-4o-mini, 60 brochures) is reported in the text.\relax }{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Venue comparison for firms with both venues ($n = 283$). The difference column is Marketing minus Brochure; the bracketed figures are a paired bootstrap 95\% CI.\relax }}{20}{table.caption.13}\protected@file@percent }
\newlabel{tab:venue}{{5}{20}{Venue comparison for firms with both venues ($n = 283$). The difference column is Marketing minus Brochure; the bracketed figures are a paired bootstrap 95\% CI.\relax }{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Marketing-corpus coverage (firms with usable website text) by adviser type and AUM quartile, with median regulatory AUM of covered versus uncovered firms. Differences are non-significant (type $\chi ^2$ $p = 0.83$; quartile $\chi ^2$ $p = 0.50$; AUM Mann--Whitney $p = 0.46$).\relax }}{20}{table.caption.14}\protected@file@percent }
\newlabel{tab:missingness}{{6}{20}{Marketing-corpus coverage (firms with usable website text) by adviser type and AUM quartile, with median regulatory AUM of covered versus uncovered firms. Differences are non-significant (type $\chi ^2$ $p = 0.83$; quartile $\chi ^2$ $p = 0.50$; AUM Mann--Whitney $p = 0.46$).\relax }{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Prevalence of each typology label among the 388 classified brochures, with Wilson 95\% confidence intervals. The dominant single label is a risk-factor disclosure (c), not a claim of use; explicit non-use (d) is essentially absent.\relax }}{21}{figure.caption.15}\protected@file@percent }
\newlabel{fig:typology}{{1}{21}{Prevalence of each typology label among the 388 classified brochures, with Wilson 95\% confidence intervals. The dominant single label is a risk-factor disclosure (c), not a claim of use; explicit non-use (d) is essentially absent.\relax }{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Disclosed any-use of AI by adviser type and AUM quartile. Bars show the within-stratum share of brochures disclosing any use (labels a, b, or e); private-fund advisers (solid) exceed wealth/retail advisers (hatched) at every size quartile, and disclosure rises strongly with size in both types.\relax }}{21}{figure.caption.16}\protected@file@percent }
\newlabel{fig:gradient}{{2}{21}{Disclosed any-use of AI by adviser type and AUM quartile. Bars show the within-stratum share of brochures disclosing any use (labels a, b, or e); private-fund advisers (solid) exceed wealth/retail advisers (hatched) at every size quartile, and disclosure rises strongly with size in both types.\relax }{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Independent cross-family validation: design-weighted Cohen's $\kappa $ between the primary classifier (gpt-4o) and a blinded re-coding by a different model family, per label and for the derived any-use indicator (two-phase verification sample, $n = 180$, weighted to the classified population). Shaded bands mark the conventional substantial (0.61--0.80) and almost-perfect ($>0.80$) agreement regions; the risk-factor label is almost-perfect and any-use is comfortably substantial, while the finer investment-process distinction remains the softest construct.\relax }}{22}{figure.caption.17}\protected@file@percent }
\newlabel{fig:validation}{{3}{22}{Independent cross-family validation: design-weighted Cohen's $\kappa $ between the primary classifier (gpt-4o) and a blinded re-coding by a different model family, per label and for the derived any-use indicator (two-phase verification sample, $n = 180$, weighted to the classified population). Shaded bands mark the conventional substantial (0.61--0.80) and almost-perfect ($>0.80$) agreement regions; the risk-factor label is almost-perfect and any-use is comfortably substantial, while the finer investment-process distinction remains the softest construct.\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Disclosed any-use of AI by venue for the 283 firms observed in both venues. Contrary to the intuition motivating AI-washing concern, the fiduciary brochure is the more AI-forward venue: disclosed use is 23.0\% in brochures versus 5.7\% in current website marketing.\relax }}{22}{figure.caption.18}\protected@file@percent }
\newlabel{fig:venue}{{4}{22}{Disclosed any-use of AI by venue for the 283 firms observed in both venues. Contrary to the intuition motivating AI-washing concern, the fiduciary brochure is the more AI-forward venue: disclosed use is 23.0\% in brochures versus 5.7\% in current website marketing.\relax }{figure.caption.18}{}}
